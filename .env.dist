DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DATABASE_URL=postgresql://postgres:password123@localhost:5432/comptago_db
CONN_MAX_AGE=0
IS_LOCAL=1

EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=replace-with-resend-api-key
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_FROM_ADDRESS=onboarding@resend.dev

TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=replace-with-twilio-phone-number

FRONTEND_URL=http://localhost:3000

USE_GPT_INVOICE_PARSER=1
OPENAI_API_KEY=replace-with-openai-api-key

DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=admin-plus
